# Blank = explicitly labelled, browser-local preview workspace.
# Set to the HTTPS origin of the future Windows or Linux backend.
# Public configuration only. Never put passwords, SDK grants or keys here.
NEXT_PUBLIC_API_BASE_URL=

# Optional compatible tile endpoint. Default is OpenStreetMap Standard.
# Public build-time setting, not a secret. Update attribution for your provider.
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
