# Public backend URL only. Provider/DB credentials never belong in this file.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8101
# For Vercel, use same-origin browser requests through the Next proxy:
# NEXT_PUBLIC_API_BASE_URL=/rgu
# RGU_API_PROXY_TARGET=https://rgu-fleet-management.hextorq.tech/rgu
# For Vercel, configure the actual HTTPS API before building.
# Optional compatible road tile endpoint; update attribution for your provider.
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
