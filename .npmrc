# Keep production installs lean and resilient on Vercel.
# - No audit/fund network round-trips during `npm ci`.
# - Reuse the restored npm cache when present, fall back to the network otherwise.
# - Retry transient registry failures instead of failing the whole build.
fund=false
audit=false
prefer-offline=true
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=180000
